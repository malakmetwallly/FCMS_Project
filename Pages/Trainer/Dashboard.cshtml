@page
@model TrainerDashboardModel
@{
    ViewData["Title"] = "Trainer Dashboard";
}

<h2>My Members</h2>

<table class="table table-bordered table-striped">
	<thead>
		<tr>
			<th>Name</th>
			<th>Age</th>
			<th>Goal</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var m in Model.Members)
		{
		<tr>
			<td>@m.Name</td>
			<td>@m.Age</td>
			<td>@m.Goal</td>
			<td>
				<a class="btn btn-primary btn-sm"
				   asp-page="AssignPlan" asp-route-memberId="@m.Member_ID">Assign Plan</a>

				<a class="btn btn-success btn-sm"
				   asp-page="Progress" asp-route-memberId="@m.Member_ID">View Progress</a>
			</td>
		</tr>
		}
	</tbody>
</table>