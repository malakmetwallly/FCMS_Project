@page "{memberId:int}"
@model ProgressModel

<h2>Progress Tracking</h2>

<table class="table table-striped">
	<thead>
		<tr>
			<th>Date</th>
			<th>Weight</th>
			<th>Muscle Mass</th>
			<th>Body Fat %</th>
			<th>Notes</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var p in Model.ProgressList)
		{
		<tr>
			<td>@p.Date_Recorded.ToShortDateString()</td>
			<td>@p.Weight</td>
			<td>@p.Muscle_Mass</td>
			<td>@p.Body_Fat_Percentage</td>
			<td>@p.Notes</td>
		</tr>
		}
	</tbody>
</table>

<hr />

<h4>Add New Progress</h4>

<form method="post">
	<input type="hidden" asp-for="MemberID" />

	<label>Weight (kg)</label>
	<input type="number" step="0.1" asp-for="Weight" class="form-control" />

	<label class="mt-2">Muscle Mass (kg)</label>
	<input type="number" step="0.1" asp-for="Muscle_Mass" class="form-control" />

	<label class="mt-2">Body Fat %</label>
	<input type="number" step="0.1" asp-for="Body_Fat_Percentage" class="form-control" />

	<label class="mt-2">Notes</label>
	<textarea rows="3" asp-for="Notes" class="form-control"></textarea>

	<button class="btn btn-success mt-3">Add</button>
</form>