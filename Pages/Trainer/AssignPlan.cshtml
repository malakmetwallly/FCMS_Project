@page "{id:int}"
@model AssignPlanModel
@{
    ViewData["Title"] = "Assign Workout Plan";
}

<h2>Assign Workout Plan</h2>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="card shadow p-4 mt-3">
    <form method="post">
        <input type="hidden" asp-for="TrainerId" value="1" />

        <div class="mb-3">
            <label class="form-label">Member Name</label>
            <input type="text" class="form-control" asp-for="MemberName" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Focus Area</label>
            <select class="form-select" asp-for="FocusArea" required>
                <option value="" selected disabled>-- Select Plan --</option>
                <option value="Beginner">Beginner</option>
                <option value="Strength">Strength</option>
                <option value="Weight Loss">Weight Loss</option>
                <option value="Muscle Gain">Muscle Gain</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Workout Details (Weekly Schedule)</label>
            <textarea class="form-control" rows="4" asp-for="WeeklySchedule" 
                      placeholder="e.g. Mon: Chest, Tue: Back..." required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Assign Plan</button>
        <a asp-page="/Dashboard" class="btn btn-secondary">Cancel</a>
    </form>
</div>
