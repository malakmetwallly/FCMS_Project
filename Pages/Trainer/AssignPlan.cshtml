@page
@model AssignPlanModel
@{
    ViewData["Title"] = "Assign Workout Plan";
}

<h2>🏋️ Assign Workout Plan</h2>

<div class="card shadow p-4 mt-3">
	<form method="post">

		<div class="mb-3">
			<label class="form-label">Member Name</label>
			<input type="text" class="form-control" value="Ahmed Ali" disabled />
		</div>

		<div class="mb-3">
			<label class="form-label">Workout Plan Type</label>
			<select class="form-select">
				<option selected disabled>-- Select Plan --</option>
				<option>Beginner</option>
				<option>Strength</option>
				<option>Weight Loss</option>
				<option>Muscle Gain</option>
			</select>
		</div>

		<div class="mb-3">
			<label class="form-label">Workout Details</label>
			<textarea class="form-control" rows="4"
					  placeholder="e.g. Day 1: Chest, Day 2: Back..."></textarea>
		</div>

		<div class="mb-3">
			<label class="form-label">Duration (Weeks)</label>
			<input type="number" class="form-control" min="1" />
		</div>

		<button class="btn btn-primary">Assign Plan</button>
		<a asp-page="Dashboard" class="btn btn-secondary">Cancel</a>

	</form>
</div>
