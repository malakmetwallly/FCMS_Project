@page
@model FCMS_Project.Pages.Classes.AttendanceModel
@{
    ViewData["Title"] = "Attendance";
}

<div class="container mt-5">
    <h2 class="mb-4">Daily Attendance</h2>

    <form method="post">
        <div class="mb-4">
            <label class="form-label fw-bold">Select Class:</label>
            <select name="SelectedClassId" class="form-select shadow-sm">
                <option value="">-- Choose a Class --</option>
                @foreach (var cls in Model.Classes)
                {
                    <option value="@cls.Id">@cls.Name | Date: @cls.ClassDate | Start: @cls.Time</option>
                }
            </select>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Mark Attendance</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Member Name</th>
                            <th class="text-center" style="width: 150px;">Is Present?</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            <tr>
                                <td class="align-middle">@member.Name</td>
                                <td class="text-center">
                                    <div class="form-check d-flex justify-content-center">
                                        <input class="form-check-input" type="checkbox"
                                               name="SelectedMembers" value="@member.Id"
                                               style="transform: scale(1.5);">
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-success btn-lg px-5">Save Attendance</button>
        </div>
    </form>
</div>