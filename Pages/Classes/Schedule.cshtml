            <td></td>
            <td class="table-info">Yoga<br><small>Capt. Sarah</small></td>
        </tr>
        <tr>
            <td class="fw-bold">06:00 PM</td>
            <td></td>
            <td class="table-warning">Boxing<br><small>Capt. Ali</small></td>
            <td></td>
            <td class="table-success">Zumba<br><small>Capt. Laila</small></td>
            <td></td>
        </tr>
