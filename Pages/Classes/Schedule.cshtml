@page
@model FCMS_Phase1.Pages.Classes.ScheduleModel

<h1>Weekly Class Schedule</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Time</th>
            <th>Mon</th>
            <th>Tue</th>
            <th>Wed</th>
            <th>Thu</th>
            <th>Fri</th>
            <th>Sat</th>
            <th>Sun</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var timeGroup in Model.WeeklyClasses.GroupBy(c => c.Time))
        {
            <tr>
                <td>@timeGroup.Key</td>
                <td>
                    @foreach (var c in timeGroup.Where(c => c.Day == "Mon"))
                    {
                        <div>@c.Name (@c.Trainer)</div>
                    }
                </td>
                <td>
                    @foreach (var c in timeGroup.Where(c => c.Day == "Tue"))
                    {
                        <div>@c.Name (@c.Trainer)</div>
                    }
                </td>
                <td>
                    @foreach (var c in timeGroup.Where(c => c.Day == "Wed"))
                    {
                        <div>@c.Name (@c.Trainer)</div>
                    }
                </td>
                <td>
                    @foreach (var c in timeGroup.Where(c => c.Day == "Thu"))
                    {
                        <div>@c.Name (@c.Trainer)</div>
                    }
                </td>
                <td>
                    @foreach (var c in timeGroup.Where(c => c.Day == "Fri"))
                    {
                        <div>@c.Name (@c.Trainer)</div>
                    }
                </td>
                <td>
                    @foreach (var c in timeGroup.Where(c => c.Day == "Sat"))
                    {
                        <div>@c.Name (@c.Trainer)</div>
                    }
                </td>
                <td>
                    @foreach (var c in timeGroup.Where(c => c.Day == "Sun"))
                    {
                        <div>@c.Name (@c.Trainer)</div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
