@page
@model FCMS_Project.Pages.Admin.FeedbackModel
@{
    ViewData["Title"] = "System Feedback";
}

<div class="container mt-4">
    <h2>User Feedback</h2>
    <hr />
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Member Name</th>
                <th>Message</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.FeedbackList)
            {
                <tr>
                    <td>@item.MemberName</td>
                    <td>@item.Message</td>
                    <td>@item.Date.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-page="/Admin/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>