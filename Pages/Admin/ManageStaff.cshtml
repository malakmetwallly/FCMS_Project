@page
@model FCMS_Project.Pages.Admin.ManageStaffModel
@{
    ViewData["Title"] = "Manage Staff";
}

<div class="container">
    <h2>Manage Staff</h2>

    <h3>Add New Member</h3>
    <form method="post" style="margin-bottom: 20px;">

        <h5 class="text-primary mt-3">1. Shared Info</h5>
        <div class="row">
            <div class="col-md-6 mb-2">
                <label>Full Name *</label>
                <input type="text" class="form-control" required />
            </div>
            <div class="col-md-6 mb-2">
                <label>Email *</label>
                <input type="email" class="form-control" required />
            </div>
            <div class="col-md-4 mb-2">
                <label>Phone Number</label>
                <input type="tel" class="form-control" />
            </div>
            <div class="col-md-4 mb-2">
                <label>Salary (EGP)</label>
                <input type="number" class="form-control" />
            </div>
            <div class="col-md-4 mb-2">
                <label>Role</label>
                <select class="form-control">
                    <option>Trainer</option>
                    <option>Receptionist</option>
                </select>
            </div>
        </div>

        <h5 class="text-success mt-3">2. For Trainers Only</h5>
        <div class="row">
            <div class="col-md-6 mb-2">
                <label>Specialty</label>
                <input type="text" class="form-control" placeholder="e.g. Bodybuilding (Trainers only)" />
            </div>
            <div class="col-md-6 mb-2">
                <label>Experience</label>
                <input type="number" class="form-control" placeholder="Years of Experience (Trainers only)" />
            </div>
        </div>

        <h5 class="text-danger mt-3">3. For Receptionists Only</h5>
        <div class="row">
            <div class="col-md-4 mb-2">
                <label>Username</label>
                <input type="text" class="form-control" placeholder="Login Username (Receptionist only)" />
            </div>
            <div class="col-md-4 mb-2">
                <label>Password</label>
                <input type="text" class="form-control" placeholder="Login Password (Receptionist only)" />
            </div>
            <div class="col-md-4 mb-2">
                <label>Shift Type</label>
                <select class="form-control">
                    <option value="">-- Select Shift (Receptionist only) --</option>
                    <option>Morning</option>
                    <option>Evening</option>
                    <option>Night</option>
                </select>
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-4 w-100">Create Staff Account</button>
    </form>

    <hr />

    <h3>Current Staff List</h3>
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Role</th>
                <th>Email</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Captain Ahmed</td>
                <td>Trainer</td>
                <td>ahmed@fcms.com</td>
                <td><button class="btn btn-danger btn-sm">Delete</button></td>
            </tr>
            <tr>
                <td>Nour Ehab</td>
                <td>Receptionist</td>
                <td>nour@fcms.com</td>
                <td><button class="btn btn-danger btn-sm">Delete</button></td>
            </tr>
        </tbody>
    </table>

    <a asp-page="/Admin/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>