@page
@model FCMS_Project.Pages.Admin.ManageStaffModel
@{
    ViewData["Title"] = "Manage Staff";
}

<div class="container">
    <h2>Manage Staff</h2>

    <h3>Add New Member</h3>
    <form method="post" style="margin-bottom: 20px;">

        <h5 class="text-primary mt-3">1. Shared Info</h5>
        <div class="row">
            <div class="col-md-6 mb-2">
                <label>Full Name *</label>
                <input type="text" name="FullName" class="form-control" required />
            </div>
            <div class="col-md-6 mb-2">
                <label>Email *</label>
                <input type="email" name="Email" class="form-control" required />
            </div>
            <div class="col-md-4 mb-2">
                <label>Phone Number</label>
                <input type="tel" name="Phone" class="form-control" />
            </div>
            <div class="col-md-4 mb-2">
                <label>Salary (EGP)</label>
                <input type="number" name="Salary" class="form-control" />
            </div>
            <div class="col-md-4 mb-2">
                <label>Role</label>
                <select name="Role" class="form-control">
                    <option value="Trainer">Trainer</option>
                    <option value="Receptionist">Receptionist</option>
                </select>
            </div>
        </div>

        <h5 class="text-success mt-3">2. For Trainers Only</h5>
        <div class="row">
            <div class="col-md-6 mb-2">
                <label>Specialty</label>
                <input type="text" name="Specialty" class="form-control" placeholder="e.g. Bodybuilding" />
            </div>
            <div class="col-md-6 mb-2">
                <label>Experience</label>
                <input type="number" name="Experience" class="form-control" placeholder="Years of Experience" />
            </div>
        </div>

        <h5 class="text-danger mt-3">3. For Receptionists Only</h5>
        <div class="row">
            <div class="col-md-4 mb-2">
                <label>Username</label>
                <input type="text" name="Username" class="form-control" />
            </div>
            <div class="col-md-4 mb-2">
                <label>Password</label>
                <input type="text" name="Password" class="form-control" />
            </div>
            <div class="col-md-4 mb-2">
                <label>Shift Type</label>
                <select name="ShiftType" class="form-control">
                    <option value="">-- Select Shift --</option>
                    <option value="Morning">Morning</option>
                    <option value="Evening">Evening</option>
                </select>
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-4 w-100">Create Staff Account</button>
    </form>

    <hr />

    <h3>Current Staff List</h3>
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Role</th>
                <th>Email</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var staff in Model.StaffList)
            {
                <tr>
                    <td>@staff.Name</td>
                    <td>@staff.Role</td>
                    <td>@staff.Email</td>
                    <td>
                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Are you sure you want to delete this staff member?');">
                            <input type="hidden" name="emailToDelete" value="@staff.Email" />
                            <input type="hidden" name="roleToDelete" value="@staff.Role" />

                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-page="/Admin/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>