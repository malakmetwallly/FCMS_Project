@page
@model FCMS_Project.Pages.Admin.AssignTrainerModel
@{
    ViewData["Title"] = "Assign Trainer";
}

<div class="container">
    <h2>Assign Trainer</h2>
    <hr />
    <form method="post" class="col-md-6">
        <label>Member</label>
        <select name="SelectedMemberId" asp-items="Model.MemberOptions" class="form-control mb-2"></select>

        <label>Trainer</label>
        <select name="SelectedTrainerId" asp-items="Model.TrainerOptions" class="form-control mb-2"></select>

        <label>Goal</label>
        <input type="text" name="Goal" class="form-control mb-3" required />

        <button type="submit" class="btn btn-primary">Assign</button>
        <a asp-page="/Admin/Dashboard" class="btn btn-secondary">Cancel</a>
    </form>
</div>