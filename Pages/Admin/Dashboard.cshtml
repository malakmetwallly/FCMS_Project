@page
@model FCMS_Project.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 class="text-center mb-4">Admin Dashboard</h1>

<div class="row text-center mb-4">
    <div class="col-md-4"><div class="card p-3 bg-light"><h3>15</h3><p>Trainers</p></div></div>
    <div class="col-md-4"><div class="card p-3 bg-light"><h3>42</h3><p>Members</p></div></div>
    <div class="col-md-4"><div class="card p-3 bg-light"><h3>50k</h3><p>Revenue</p></div></div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card p-3 mb-3">
            <h4>Staff Management</h4>
            <a asp-page="/Admin/ManageStaff" class="btn btn-dark">Manage Staff</a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 mb-3">
            <h4>Assignments</h4>
            <a asp-page="/Admin/AssignTrainer" class="btn btn-dark">Assign Trainer</a>
        </div>
    </div>
</div>

<div class="col-md-6 mb-3">
    <div class="card p-3">
        <h4>Feedback</h4>
        <a asp-page="/Admin/Feedback" class="btn btn-dark">View Messages</a>
    </div>
</div>