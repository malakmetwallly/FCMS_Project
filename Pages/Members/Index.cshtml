@page
@model FCMS_Project.Pages.Members.IndexModel
@{
    ViewData["Title"] = "Reception - Member Management";
}

<div class="container">
    <h2 class="mb-4">🏋️ Member Management (Reception)</h2>

    <div class="card p-3 mb-4 bg-light">
        <div class="row">
            <div class="col-md-8">
                <input type="text" class="form-control" placeholder="Search by Member Name or Phone..." />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary w-100">🔍 Search Member</button>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <a href="#" class="btn btn-success">+ Register New Member</a>
    </div>

    <table class="table table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Membership Type</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>101</td>
                <td>Nour Hossam</td>
                <td>Premium (1 Year)</td>
                <td><span class="badge bg-success">Active</span></td>
                <td>
                    <button class="btn btn-sm btn-info">View Profile</button>
                    <button class="btn btn-sm btn-warning">Edit</button>
                </td>
            </tr>
            <tr>
                <td>102</td>
                <td>Ahmed Ali</td>
                <td>Standard (1 Month)</td>
                <td><span class="badge bg-danger">Expired</span></td>
                <td>
                    <button class="btn btn-sm btn-info">View Profile</button>
                    <button class="btn btn-sm btn-warning">Edit</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>