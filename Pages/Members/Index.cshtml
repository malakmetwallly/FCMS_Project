@page
@model MemberWebApp.Pages.Members.IndexModel

<h1>All Members</h1>

<form method="get">
    <div class="form-group">
        <label>Search by Name:</label>
        <input asp-for="Search" class="form-control" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Goal</th>
            <th>Membership Type</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model.Members)
        {
            <tr>
                <td>@member.Name</td>
                <td>@member.Age</td>
                <td>@member.Goal</td>
                <td>@member.Membership_Type</td>
                <td>
                    <a asp-page="Profile" asp-route-id="@member.Member_ID">View Profile</a>
                </td>
            </tr>
        }
    </tbody>
</table>