@page
@model FCMS_Project.Pages.Members.RegisterModel

<h2>Register New Member</h2>

<form method="post">

    <label>Name</label>
    <input asp-for="Name" class="form-control mb-2" required />

    <label>Email</label>
    <input asp-for="Email" type="email" class="form-control mb-2" required />

    <label>Phone</label>
    <input asp-for="Phone" class="form-control mb-2" />

    <label>Age</label>
    <input asp-for="Age" type="number" class="form-control mb-2" />

    <label>Height (cm)</label>
    <input asp-for="Height" type="number" step="0.1" class="form-control mb-2" />

    <label>Weight (kg)</label>
    <input asp-for="Weight" type="number" step="0.1" class="form-control mb-2" />

    <label>Gender</label>
    <select asp-for="Gender" class="form-control mb-2">
        <option>Male</option>
        <option>Female</option>
    </select>

    <label>Membership Type</label>
    <select asp-for="Membership_Type" class="form-control mb-2">
        <option>Silver</option>
        <option>Gold</option>
        <option>Platinum</option>
    </select>

    <label>Goal</label>
    <input asp-for="Goal" class="form-control mb-3" />

    <button class="btn btn-primary">Register</button>
    <a asp-page="/Members/Index" class="btn btn-secondary ms-2">Cancel</a>

    <p style="color:red">@Model.ErrorMessage</p>
    <p style="color:green">@Model.SuccessMessage</p>

</form>
