@page
@model MemberWebApp.Pages.Members.RegisterModel

<h1>Register New Member</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Member.Name">Name</label>
        <input asp-for="Member.Name" class="form-control" required />
    </div>
    <div class="form-group">
        <label asp-for="Member.Email">Email</label>
        <input asp-for="Member.Email" class="form-control" type="email" required />
    </div>
    <div class="form-group">
        <label asp-for="Member.Phone">Phone</label>
        <input asp-for="Member.Phone" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Member.Weight">Weight (kg)</label>
        <input asp-for="Member.Weight" class="form-control" type="number" step="0.1" />
    </div>
    <div class="form-group">
        <label asp-for="Member.Height">Height (cm)</label>
        <input asp-for="Member.Height" class="form-control" type="number" step="0.1" />
    </div>
    <div class="form-group">
        <label asp-for="Member.Age">Age</label>
        <input asp-for="Member.Age" class="form-control" type="number" required />
    </div>
    <div class="form-group">
        <label asp-for="Member.Gender">Gender</label>
        <select asp-for="Member.Gender" class="form-control">
            <option value="Male">Male</option>
            <option value="Female">Female</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="Member.Membership_Type">Membership Type</label>
        <select asp-for="Member.Membership_Type" class="form-control">
            <option value="Basic">Basic</option>
            <option value="Premium">Premium</option>
            <option value="VIP">VIP</option>
            <option value="Trial">Trial</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="Member.Goal">Goal</label>
        <textarea asp-for="Member.Goal" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Register</button>
</form>