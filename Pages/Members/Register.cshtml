@page
@model FCMS_Project.Pages.Members.RegisterModel

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-body">

            <h3 class="text-primary fw-bold">
                Register New Member
            </h3>
            <p class="text-muted">
                Reception: fill in member details and assign trainer
            </p>

            <hr />

            <form method="post">
                <label>Name</label>
                <input asp-for="Name" class="form-control mb-2" />

                <label>Age</label>
                <input asp-for="Age" type="number" class="form-control mb-2" />

                <label>Height (cm)</label>
                <input asp-for="Height" type="number" class="form-control mb-2" />

                <label>Weight (kg)</label>
                <input asp-for="Weight" type="number" class="form-control mb-2" />

                <label>Goal</label>
                <input asp-for="Goal" class="form-control mb-2" />

                <label>Assigned Trainer</label>
                <input asp-for="Trainer" class="form-control mb-2" />

                <div class="form-check mb-3">
                    <input asp-for="HasPaid" class="form-check-input" />
                    <label class="form-check-label">
                        Payment completed
                    </label>
                </div>

                <button class="btn btn-primary">Register Member</button>
                <a asp-page="/Members/Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>
            </form>

        </div>
    </div>
</div>
